        ],
        "default": "auto"
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "transport",
        "label": "On-screen transport buttons",
        "default": true
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "tip",
        "label": "Offer to hide the on-screen buttons",
        "default": true
      }
    },
