        "choices": [
          "written",
          "printed",
          "clear"
        ],
        "default": "written"
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "tapeArt",
        "label": "Album art on the written cassette label",
        "default": true
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "wheel",
        "label": "Rotary wheel",
        "choices": [
          "volume",
          "seek"
