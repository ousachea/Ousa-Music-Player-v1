{
  "id": "01a07715-9963-72b3-9c4e-edcc6f6ebb6f",
  "name": "Music Player",
  "version": "0.18.5",
  "description": "Now playing from your phone, on the Car Thing.",
  "icon": "icon.jpg",
  "settings": "settings.html",
  "config": [
    {
      "type": "enum",
      "data": {
        "key": "theme",
        "label": "Player style",
        "choices": [
          "card",
          "vinyl",
          "poster"
        ],
        "default": "card"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "wheel",
        "label": "Rotary wheel",
        "choices": [
          "volume",
          "seek"
        ],
        "default": "volume"
      }
    },
    {
      "type": "number",
      "data": {
        "key": "seekSeconds",
        "label": "Seek step per wheel click (seconds)",
        "min": 1,
        "max": 30,
        "step": 1,
        "default": 2
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "seek",
        "label": "Seek bar",
        "choices": [
          "auto",
          "bar",
          "wave"
        ],
        "default": "auto"
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "hdArt",
        "label": "HD album art",
        "default": true
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "accent",
        "label": "Accent colour",
        "choices": [
          "artwork",
          "mono"
        ],
        "default": "artwork"
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "pulse",
        "label": "Cover pulse",
        "default": true
      }
    },
    {
      "type": "number",
      "data": {
        "key": "pulseBpm",
        "label": "Pulse tempo in BPM (0 for auto)",
        "min": 0,
        "max": 180,
        "step": 5,
        "default": 0
      }
    },
    {
      "type": "number",
      "data": {
        "key": "backdrop",
        "label": "Artwork backdrop intensity (%)",
        "min": 0,
        "max": 100,
        "step": 10,
        "default": 70
      }
    },
    {
      "type": "number",
      "data": {
        "key": "drift",
        "label": "Backdrop drift intensity (%)",
        "min": 0,
        "max": 100,
        "step": 10,
        "default": 40
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "motion",
        "label": "Animations (seek bar, record spin)",
        "default": true
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "remaining",
        "label": "Show time remaining instead of track length",
        "default": true
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "clock",
        "label": "Show a clock",
        "default": true
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "clockPos",
        "label": "Clock position",
        "choices": [
          "left",
          "center",
          "right"
        ],
        "default": "right"
      }
    },
    {
      "type": "number",
      "data": {
        "key": "clockSize",
        "label": "Clock size (%)",
        "min": 70,
        "max": 200,
        "step": 10,
        "default": 100
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "clockSeconds",
        "label": "Clock shows seconds",
        "default": true
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "clockFormat",
        "label": "Clock format",
        "choices": [
          "auto",
          "h12",
          "h24"
        ],
        "default": "auto"
      }
    }
  ],
  "permissions": [
    "net.proxy"
  ],
  "overlays": {
    "volume": false
  },
  "art": {
    "heroPx": 1024,
    "thumbPx": 256
  }
}
