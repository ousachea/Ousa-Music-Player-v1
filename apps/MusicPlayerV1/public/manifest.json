{
  "id": "01a07715-9963-72b3-9c4e-edcc6f6ebb6f",
  "name": "O-Music Player",
  "version": "0.35.0",
  "description": "Now playing from your phone, in five styles coloured by the album art, and turnable to any mounting.",
  "icon": "icon.jpg",
  "settings": "settings.html",
  "config": [
    {
      "type": "enum",
      "data": {
        "key": "theme",
        "label": "Player style",
        "choices": [
          "widget",
          "vinyl",
          "cd",
          "cassette",
          "dial",
          "poster",
          "lyrics"
        ],
        "default": "widget"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "rotate",
        "label": "Screen rotation",
        "choices": [
          "0",
          "90",
          "180",
          "270"
        ],
        "default": "0"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "lyricsInfo",
        "label": "Where the track sits in Lyrics",
        "choices": [
          "tl",
          "bl",
          "tr",
          "br"
        ],
        "default": "tl"
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "words",
        "label": "Show the words in Lyrics",
        "default": true
      }
    },
    {
      "type": "number",
      "data": {
        "key": "lyricSize",
        "label": "Lyrics text size (%)",
        "min": 70,
        "max": 160,
        "step": 10,
        "default": 100
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "coverEdge",
        "label": "Album art runs to the screen edge",
        "default": false
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "coverPanel",
        "label": "Panel behind the track and controls",
        "default": false
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "coverVolume",
        "label": "Volume slider",
        "default": true
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "vinylStyle",
        "label": "Vinyl layout",
        "choices": [
          "turntable",
          "sleeve"
        ],
        "default": "turntable"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "vinylFront",
        "label": "Vinyl front",
        "choices": [
          "record",
          "sleeve"
        ],
        "default": "record"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "vinylTint",
