        "min": 0,
        "max": 180,
        "step": 5,
        "default": 0
      }
    },
    {
      "type": "number",
      "data": {
        "key": "backdrop",
        "label": "Artwork backdrop intensity (%)",
        "min": 0,
        "max": 100,
        "step": 10,
        "default": 100
      }
    },
    {
      "type": "number",
      "data": {
        "key": "blur",
        "label": "Artwork backdrop blur (%)",
        "min": 0,
        "max": 100,
        "step": 10,
        "default": 60
      }
    },
    {
      "type": "number",
      "data": {
        "key": "drift",
        "label": "Backdrop drift intensity (%)",
        "min": 0,
        "max": 100,
        "step": 10,
        "default": 100
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "motion",
        "label": "Animations (seek bar, record spin)",
        "default": true
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "notes",
        "label": "Floating music notes",
        "default": true
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "remaining",
        "label": "Show time remaining instead of track length",
        "default": true
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "clock",
        "label": "Show a clock",
        "default": true
      }
