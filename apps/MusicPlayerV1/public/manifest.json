{
  "id": "01a07715-9963-72b3-9c4e-edcc6f6ebb6f",
  "name": "Ousa Music player v1",
  "version": "0.6.1",
  "description": "Now playing from your phone, on the Car Thing.",
  "icon": "icon.png",
  "settings": "settings.html",
  "config": [
    {
      "type": "enum",
      "data": {
        "key": "theme",
        "label": "Player style",
        "choices": [
          "card",
          "vinyl"
        ],
        "default": "card"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "wheel",
        "label": "Rotary wheel",
        "choices": [
          "volume",
          "seek"
        ],
        "default": "volume"
      }
    },
    {
      "type": "number",
      "data": {
        "key": "seekSeconds",
        "label": "Seek step per wheel click (seconds)",
        "min": 1,
        "max": 30,
        "step": 1,
        "default": 2
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "accent",
        "label": "Accent colour",
        "choices": [
          "artwork",
          "mono"
        ],
        "default": "artwork"
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "backdrop",
        "label": "Blurred artwork background",
        "default": true
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "motion",
        "label": "Animations (seek bar, record spin)",
        "default": true
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "remaining",
        "label": "Show time remaining instead of track length",
        "default": true
      }
    }
  ],
  "permissions": [
    "net.proxy"
  ],
  "art": {
    "heroPx": 248,
    "thumbPx": 96
  }
}
