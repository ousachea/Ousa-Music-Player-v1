{
  "id": "01a17177-893e-7726-bed0-f3e3b3847724",
  "name": "O-Deck",
  "version": "0.1.0",
  "description": "Big tiles that work the Mac your Car Thing is plugged into: shortcuts, apps, volume, mic and more.",
  "icon": "icon.png",
  "settings": "settings.html",
  "config": [],
  "permissions": [],
  "art": {
    "heroPx": 248,
    "thumbPx": 96
  },
  "extension": {
    "entry": "extension/desktop.mjs",
    "permissions": [
      "run:/usr/bin/osascript",
      "run:/usr/bin/shortcuts",
      "run:/usr/bin/open",
      "run:/usr/bin/pmset",
      "run:/usr/sbin/screencapture",
      "read:/Applications",
      "read:/System/Applications",
      "env:HOME",
      "run:/usr/bin/caffeinate",
      "run:/usr/sbin/networksetup",
      "run:/usr/bin/defaults"
    ],
    "api": 1
  }
}
