{
  "id": "01a07c16-be12-7003-91aa-482b107fdccb",
  "name": "O-System Monitor",
  "version": "0.4.2",
  "description": "CPU, GPU, memory, network and storage for your machines, on the Car Thing.",
  "icon": "icon.png",
  "settings": "settings.html",
  "config": [],
  "permissions": [
    "net.proxy",
    "geo"
  ],
  "art": {
    "heroPx": 248,
    "thumbPx": 96
  },
  "extension": {
    "entry": "extension/desktop.mjs",
    "permissions": [
      "run:/usr/bin/vm_stat",
      "run:/usr/sbin/sysctl",
      "run:/usr/sbin/ioreg",
      "run:/usr/sbin/netstat",
      "run:/bin/ps",
      "run:/usr/bin/pmset",
      "run:/bin/df",
      "run:/sbin/ping",
      "run:/sbin/route",
      "run:/usr/sbin/system_profiler",
      "run:/usr/bin/sw_vers",
      "run:/usr/sbin/scutil",
      "run:/sbin/ifconfig",
      "run:/usr/sbin/networksetup",
      "read:/proc",
      "read:/sys",
      "read:/etc/os-release",
      "run:df",
      "run:ping",
      "run:nvidia-smi",
      "run:C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "read:~/.claude",
      "read:~/.config/claude",
      "env:HOME",
      "env:USERPROFILE",
      "env:CLAUDE_CONFIG_DIR",
      "sys"
    ],
    "api": 1
  }
}
