{
  "id": "01a07c16-be12-7003-91aa-482b107fdccb",
  "name": "O-System Monitor",
  "version": "0.2.0",
  "description": "CPU, GPU, memory, network and storage for your machines, on the Car Thing.",
  "icon": "icon.png",
  "settings": "settings.html",
  "config": [],
  "permissions": [
    "net.proxy"
  ],
  "art": {
    "heroPx": 248,
    "thumbPx": 96
  },
  "extension": {
    "entry": "extension/desktop.mjs",
    "permissions": [
      "run:/usr/bin/vm_stat",
      "run:/usr/sbin/sysctl",
      "run:/usr/sbin/ioreg",
      "run:/usr/sbin/netstat",
      "run:/bin/ps",
      "run:/usr/bin/pmset",
      "run:/bin/df",
      "run:/sbin/ping",
      "run:/sbin/route",
      "run:/usr/sbin/system_profiler",
      "run:/usr/bin/sw_vers",
      "run:/usr/sbin/scutil",
      "run:/sbin/ifconfig",
      "run:/usr/sbin/networksetup",
      "sys"
    ],
    "api": 1
  }
}
